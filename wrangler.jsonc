{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "be",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  // /api/* だけ Worker が処理する。それ以外は静的アセットで、/<uuid> は index.html にフォールバックする
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // クラウド保存先
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "be-docs" }],
  // 書きこみ(PUT)の回数制限。IP ごとに 60 秒あたり 20 回まで
  "ratelimits": [{ "name": "WRITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }]
}
